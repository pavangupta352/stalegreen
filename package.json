{
  "name": "stalegreen",
  "version": "0.1.0",
  "description": "Hooks that keep a coding agent's green claims honest: verification runs are recorded unmasked, and \"done\" is blocked when the evidence is stale, failed or masked.",
  "type": "module",
  "license": "MIT",
  "author": "Pavan Gupta <pavan.gupta.352@gmail.com>",
  "homepage": "https://github.com/pavangupta352/stalegreen#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pavangupta352/stalegreen.git"
  },
  "bugs": {
    "url": "https://github.com/pavangupta352/stalegreen/issues"
  },
  "bin": {
    "stalegreen": "dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".claude-plugin",
    "hooks"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest run --exclude test/perf.test.ts && vitest run test/perf.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test",
    "test:perf": "vitest run test/perf.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "claude-code",
    "codex",
    "deepseek-harness",
    "coding-agent",
    "hooks",
    "verification",
    "tests",
    "evidence",
    "agent-safety"
  ]
}
