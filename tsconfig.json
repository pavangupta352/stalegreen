{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "outDir": "dist",
    "rootDir": ".",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "stalegreen": [
        "./src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "dsh-plugin-stalegreen/src"
  ]
}
