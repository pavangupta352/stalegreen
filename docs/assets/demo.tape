# Renders docs/assets/demo.gif. Run from the repository root:
#   npm run build && vhs docs/assets/demo.tape
Output docs/assets/demo.gif

Set Shell bash
Set FontFamily "Menlo"
Set FontSize 15
Set Width 1280
Set Height 720
Set Padding 24
Set Theme "Catppuccin Mocha"
Set WindowBar Colorful
Set WindowBarSize 40
Set Framerate 30
Set PlaybackSpeed 1.0
Set TypingSpeed 40ms

Hide
Type "clear && bash docs/assets/demo.sh"
Enter
Show
Sleep 19s
